name: Deploy website to AWS

on:
  push:
    branches:
      - main

permissions:
  id-token: write
  contents: read

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Get project files
        uses: actions/checkout@v4

      - name: Get temporary AWS permission
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: arn:aws:iam::894196686483:role/github-actions-neinei-deploy
          aws-region: ap-southeast-2

      - name: Upload website to S3
        run: aws s3 cp index.html s3://neinei-cloud-lab-2026/index.html
